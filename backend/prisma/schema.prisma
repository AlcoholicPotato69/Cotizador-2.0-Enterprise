generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  engineType      = "binary"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model Tenant {
  id                       String                    @id @default(uuid())
  name                     String
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  deletedAt                DateTime?                 @map("deleted_at")
  deletedBy                String?                   @map("deleted_by")
  agreements               Agreement[]
  agreementApprovals       AgreementApproval[]
  agreementEvidences       AgreementEvidence[]
  agreementFiles           AgreementFile[]
  agreementItems           AgreementItem[]
  agreementSignatures      AgreementSignature[]
  agreementSnapshots       AgreementSnapshot[]
  agreementVersions        AgreementVersion[]
  archiveJobs              ArchiveJob[]
  archivePolicies          ArchivePolicy[]
  archiveRecords           ArchiveRecord[]
  calendarEvents           CalendarEvent[]
  catalogCategories        CatalogCategory[]
  catalogItems             CatalogItem[]
  catalogPrices            CatalogPrice[]
  catalogSnapshots         CatalogSnapshot[]
  catalogVersions          CatalogVersion[]
  clauseVersions           ClauseVersion[]
  clients                  Client[]
  clientFiles              ClientFile[]
  clientFileDocuments      ClientFileDocument[]
  contracts                Contract[]
  contractClauses          ContractClause[]
  contractFiles            ContractFile[]
  contractTemplates        ContractTemplate[]
  contractTemplateVersions ContractTemplateVersion[]
  creditApplications       CreditApplication[]
  creditTransactions       CreditTransaction[]
  customerCreditBalances   CustomerCreditBalance[]
  documents                Document[]
  documentReviews          DocumentReview[]
  documentReviewDecisions  DocumentReviewDecision[]
  documentReviewSteps      DocumentReviewStep[]
  financialFiles           FinancialFile[]
  globalSearchIndices      GlobalSearchIndex[]
  healthCheckMetrics       HealthCheckMetric[]
  inboxEvents              InboxEvent[]
  invoices                 Invoice[]
  invoiceTemplates         InvoiceTemplate[]
  jobExecutions            JobExecution[]
  jobFailures              JobFailure[]
  jobQueues                JobQueue[]
  jobRetries               JobRetry[]
  notificationQueues       NotificationQueue[]
  numberingSequences       NumberingSequence[]
  outboxDispatches         OutboxDispatch[]
  outboxEvents             OutboxEvent[]
  outboxFailures           OutboxFailure[]
  payments                 Payment[]
  paymentAllocations       PaymentAllocation[]
  paymentEvidences         PaymentEvidence[]
  pdfDocuments             PdfDocument[]
  pdfTemplates             PdfTemplate[]
  permissions              Permission[]
  quotes                   Quote[]
  quoteFiles               QuoteFile[]
  quoteTemplates           QuoteTemplate[]
  receiptTemplates         ReceiptTemplate[]
  regulations              Regulation[]
  regulationAcceptances    RegulationAcceptance[]
  regulationTemplates      RegulationTemplate[]
  regulationVersions       RegulationVersion[]
  roles                    Role[]
  signatures               Signature[]
  signatureEvidences       SignatureEvidence[]
  spaces                   Space[]
  spaceAvailabilityRules   SpaceAvailabilityRule[]
  spaceConfigurations      SpaceConfiguration[]
  occupancies              SpaceOccupancy[]
  spaceRules               SpaceRule[]
  storageMetadatas         StorageMetadata[]
  templateVariables        TemplateVariable[]
  users                    User[]
  workflowDefinitions      WorkflowDefinition[]
  workflowRules            WorkflowRule[]
  workflowStates           WorkflowState[]
  workflowTransitions      WorkflowTransition[]
  workflowVersions         WorkflowVersion[]
  tenantSettings           TenantSettings?
}

model User {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")
  email        String     @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  deletedBy    String?    @map("deleted_by")
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  roles        UserRole[]

  @@index([tenantId])
  @@index([email])
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  deletedBy   String?          @map("deleted_by")
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
}

model Permission {
  id        String           @id @default(uuid())
  tenantId  String           @map("tenant_id")
  name      String
  action    String
  resource  String
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")
  deletedBy String?          @map("deleted_by")
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  roles     RolePermission[]

  @@unique([tenantId, name])
}

model UserRole {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  roleId    String    @map("role_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")
  role      Role      @relation(fields: [roleId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  deletedBy    String?    @map("deleted_by")
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model AuditLog {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  action        String
  payload       Json
  previousHash  String    @map("previous_hash")
  currentHash   String    @map("current_hash")
  chainHash     String    @unique @map("chain_hash")
  correlationId String?   @map("correlation_id")
  traceId       String?   @map("trace_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?   @map("deleted_by")

  @@unique([tenantId, previousHash])
  @@index([tenantId])
  @@index([correlationId])
}

model Snapshot {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  entityType   String    @map("entity_type")
  payloadHash  String    @map("payload_hash")
  previousHash String?   @map("previous_hash")
  chainHash    String    @unique @map("chain_hash")
  version      Int       @default(1)
  payload      Json
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  @@unique([tenantId, entityType, previousHash])
}

model FeatureFlag {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  featureKey        String    @map("feature_key")
  enabled           Boolean   @default(false)
  rolloutPercentage Int       @default(100) @map("rollout_percentage")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?   @map("deleted_by")
}

model TaxConfiguration {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  taxName    String    @map("tax_name")
  taxRate    Decimal   @map("tax_rate") @db.Decimal(5, 4)
  validFrom  DateTime  @map("valid_from")
  validUntil DateTime? @map("valid_until")
  isDefault  Boolean   @default(false) @map("is_default")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
}

model Currency {
  code      String    @id
  symbol    String
  decimals  Int
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")
}

model Client {
  id                 String                  @id @default(uuid())
  tenantId           String                  @map("tenant_id")
  name               String                  @default("")
  email              String?
  phone              String?
  rfc                String?
  status             ClientStatus            @default(LEAD)
  bankReference      String?                 @map("bank_reference")
  isTaxValidated     Boolean                 @default(false) @map("is_tax_validated")
  isContractBlocked  Boolean                 @default(false) @map("is_contract_blocked")
  isInvoiceBlocked   Boolean                 @default(false) @map("is_invoice_blocked")
  isPaymentBlocked   Boolean                 @default(false) @map("is_payment_blocked")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  deletedAt          DateTime?               @map("deleted_at")
  deletedBy          String?                 @map("deleted_by")
  agreements         Agreement[]
  tenant             Tenant                  @relation(fields: [tenantId], references: [id])
  clientFiles        ClientFile[]
  contracts          Contract[]
  creditApplications CreditApplication[]
  creditTransactions CreditTransaction[]
  creditBalances     CustomerCreditBalance[]
  invoices           Invoice[]
  payments           Payment[]
  quotes             Quote[]

  @@unique([tenantId, bankReference])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Space {
  id                     String                  @id @default(uuid())
  tenantId               String                  @map("tenant_id")
  name                   String
  code                   String?                 @map("code")
  capacity               Int
  areaSqm                Decimal                 @db.Decimal(10, 2)
  basePricePerHour       Decimal                 @db.Decimal(12, 4)
  configB2b              Json                    @map("config_b2b")
  preciosPorDia          Json                    @map("precios_por_dia")
  diasBloqueados         Json                    @map("dias_bloqueados")
  impuestosIds           String[]                @map("impuestos_ids")
  status                 SpaceStatus             @default(AVAILABLE)
  description            String
  color                  String?
  tags                   Json
  spaceType              String                  @map("space_type")
  material               String?
  width                  Decimal?                @db.Decimal(10, 2)
  height                 Decimal?                @db.Decimal(10, 2)
  measureUnit            String?                 @map("measure_unit")
  location               String?
  allowsAgreement        Boolean                 @default(false) @map("allows_agreement")
  regulationTemplate     String                  @map("regulation_template")
  planoPdf               String                  @map("plano_pdf")
  geographicMap          String?                 @map("geographic_map")
  isDigital              Boolean                 @default(false) @map("is_digital")
  images                 Json
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  deletedAt              DateTime?               @map("deleted_at")
  deletedBy              String?                 @map("deleted_by")
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  spaceAvailabilityRules SpaceAvailabilityRule[]
  spaceConfigurations    SpaceConfiguration[]
  occupancies            SpaceOccupancy[]
  spaceRules             SpaceRule[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model SpaceOccupancy {
  id                  String          @id @default(uuid())
  tenantId            String          @map("tenant_id")
  spaceId             String          @map("space_id")
  occupancySourceType String          @map("occupancy_source_type")
  occupancySourceId   String          @map("occupancy_source_id")
  startTime           DateTime        @map("start_time")
  endTime             DateTime        @map("end_time")
  status              OccupancyStatus @default(HOLD)
  correlationId       String?         @map("correlation_id")
  traceId             String?         @map("trace_id")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  deletedAt           DateTime?       @map("deleted_at")
  deletedBy           String?         @map("deleted_by")
  space               Space           @relation(fields: [spaceId], references: [id])
  tenant              Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([spaceId])
  @@index([tenantId, spaceId, startTime, endTime])
  @@index([occupancySourceType, occupancySourceId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model Document {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  currentHash    String    @map("current_hash")
  previousHash   String?   @map("previous_hash")
  chainHash      String    @unique @map("chain_hash")
  legalHold      Boolean   @default(false) @map("legal_hold")
  retentionUntil DateTime? @map("retention_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")
  tenant         Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, previousHash])
}

model NotificationQueue {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  type      String
  recipient String
  payload   Json
  status    String    @default("PENDING")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Quote {
  id                  String      @id @default(uuid())
  tenantId            String      @map("tenant_id")
  clientId            String      @map("client_id")
  clientSnapshotId    String      @map("client_snapshot_id")
  occupancySnapshotId String      @map("occupancy_snapshot_id")
  currencyCode        String      @map("currency_code")
  totalAmount         Decimal     @map("total_amount") @db.Decimal(15, 4)
  desglosePrecios     Json        @map("desglose_precios")
  status              QuoteStatus @default(DRAFT)
  correlationId       String?     @map("correlation_id")
  traceId             String?     @map("trace_id")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  deletedAt           DateTime?   @map("deleted_at")
  deletedBy           String?     @map("deleted_by")
  contracts           Contract[]
  client              Client      @relation(fields: [clientId], references: [id])
  tenant              Tenant      @relation(fields: [tenantId], references: [id])
  quoteFiles          QuoteFile[]

  @@index([tenantId])
  @@index([clientId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model Contract {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  clientId        String         @map("client_id")
  quoteId         String?        @map("quote_id")
  quoteSnapshotId String         @map("quote_snapshot_id")
  currencyCode    String         @map("currency_code")
  templateVersion String         @map("template_version")
  templateHash    String         @map("template_hash")
  status          ContractStatus @default(DRAFT)
  correlationId   String?        @map("correlation_id")
  traceId         String?        @map("trace_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")
  deletedBy       String?        @map("deleted_by")
  client          Client         @relation(fields: [clientId], references: [id])
  quote           Quote?         @relation(fields: [quoteId], references: [id])
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  contractFiles   ContractFile[]
  invoices        Invoice[]
  signatures      Signature[]

  @@index([tenantId])
  @@index([clientId])
  @@index([quoteId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model Signature {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  contractId      String    @map("contract_id")
  participantName String    @map("participant_name")
  participantRole String    @map("participant_role")
  signatureHash   String    @map("signature_hash")
  ipAddress       String?   @map("ip_address")
  signedAt        DateTime  @default(now()) @map("signed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")
  contract        Contract  @relation(fields: [contractId], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([contractId])
}

model Invoice {
  id                 String              @id @default(uuid())
  tenantId           String              @map("tenant_id")
  folio              String              @map("folio")
  clientId           String              @map("client_id")
  contractId         String?             @map("contract_id")
  contractSnapshotId String              @map("contract_snapshot_id")
  currencyCode       String              @map("currency_code")
  totalAmount        Decimal             @map("total_amount") @db.Decimal(15, 4)
  amountPaid         Decimal             @map("amount_paid") @db.Decimal(15, 4)
  balanceDue         Decimal             @map("balance_due") @db.Decimal(15, 4)
  paymentStatus      String              @map("payment_status")
  status             InvoiceStatus       @default(DRAFT)
  correlationId      String?             @map("correlation_id")
  traceId            String?             @map("trace_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  deletedBy          String?             @map("deleted_by")
  financialFiles     FinancialFile[]
  client             Client              @relation(fields: [clientId], references: [id])
  contract           Contract?           @relation(fields: [contractId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  payments           Payment[]
  allocations        PaymentAllocation[]

  @@unique([tenantId, folio])
  @@index([tenantId])
  @@index([clientId])
  @@index([contractId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model Payment {
  id                 String              @id @default(uuid())
  tenantId           String              @map("tenant_id")
  folio              String              @map("folio")
  clientId           String?             @map("client_id")
  invoiceId          String              @map("invoice_id")
  currencyCode       String              @map("currency_code")
  paymentAmount      Decimal             @map("payment_amount") @db.Decimal(15, 4)
  status             PaymentStatus       @default(DRAFT)
  invoiceSnapshotId  String?             @map("invoice_snapshot_id")
  contractSnapshotId String?             @map("contract_snapshot_id")
  clientSnapshotId   String?             @map("client_snapshot_id")
  rejectionReason    String?             @map("rejection_reason")
  correlationId      String?             @map("correlation_id")
  traceId            String?             @map("trace_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  deletedBy          String?             @map("deleted_by")
  client             Client?             @relation(fields: [clientId], references: [id])
  invoice            Invoice             @relation(fields: [invoiceId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  allocations        PaymentAllocation[]
  evidences          PaymentEvidence[]

  @@unique([tenantId, folio])
  @@index([tenantId])
  @@index([clientId])
  @@index([invoiceId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model PaymentEvidence {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  paymentId            String    @map("payment_id")
  url                  String
  documentHash         String    @map("document_hash")
  previousDocumentHash String?   @map("previous_document_hash")
  chainHash            String    @unique @map("chain_hash")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")
  deletedBy            String?   @map("deleted_by")
  payment              Payment   @relation(fields: [paymentId], references: [id])
  tenant               Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([paymentId])
}

model ClientFile {
  id        String               @id @default(uuid())
  tenantId  String               @map("tenant_id")
  clientId  String               @map("client_id")
  name      String
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  deletedAt DateTime?            @map("deleted_at")
  deletedBy String?              @map("deleted_by")
  client    Client               @relation(fields: [clientId], references: [id])
  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  documents ClientFileDocument[]

  @@index([tenantId])
  @@index([clientId])
}

model ClientFileDocument {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")
  clientFileId String     @map("client_file_id")
  url          String
  documentType String     @map("document_type")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  deletedBy    String?    @map("deleted_by")
  clientFile   ClientFile @relation(fields: [clientFileId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([clientFileId])
}

model QuoteFile {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  quoteId   String    @map("quote_id")
  url       String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")
  quote     Quote     @relation(fields: [quoteId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([quoteId])
}

model ContractFile {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  contractId String    @map("contract_id")
  url        String
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
  contract   Contract  @relation(fields: [contractId], references: [id])
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([contractId])
}

model FinancialFile {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  invoiceId String    @map("invoice_id")
  url       String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")
  invoice   Invoice   @relation(fields: [invoiceId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
}

model AgreementFile {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  agreementId String    @map("agreement_id")
  url         String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")
  agreement   Agreement @relation(fields: [agreementId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([agreementId])
}

model Agreement {
  id            String               @id @default(uuid())
  tenantId      String               @map("tenant_id")
  clientId      String               @map("client_id")
  title         String
  type          AgreementType        @default(SERVICE)
  description   String?
  validFrom     DateTime?            @map("valid_from")
  validUntil    DateTime?            @map("valid_until")
  value         Decimal?             @db.Decimal(15, 4)
  currencyCode  String?              @map("currency_code")
  status        AgreementStatusEnum  @default(DRAFT)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  deletedAt     DateTime?            @map("deleted_at")
  deletedBy     String?              @map("deleted_by")
  correlationId String?              @map("correlation_id")
  traceId       String?              @map("trace_id")
  client        Client               @relation(fields: [clientId], references: [id])
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  approvals     AgreementApproval[]
  evidences     AgreementEvidence[]
  files         AgreementFile[]
  items         AgreementItem[]
  signatures    AgreementSignature[]
  snapshots     AgreementSnapshot[]
  versions      AgreementVersion[]

  @@index([tenantId])
  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@index([correlationId])
  @@index([clientId])
  @@index([tenantId, createdAt])
}

model AgreementVersion {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  agreementId       String    @map("agreement_id")
  versionNumber     Int       @map("version_number")
  contentHash       String    @map("content_hash")
  payload           Json?
  changeDescription String?   @map("change_description")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?   @map("deleted_by")
  agreement         Agreement @relation(fields: [agreementId], references: [id])
  tenant            Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([agreementId, versionNumber])
  @@index([tenantId])
}

model AgreementItem {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  agreementId  String    @map("agreement_id")
  description  String
  quantity     Decimal   @default(1) @db.Decimal(10, 2)
  unitPrice    Decimal   @default(0) @map("unit_price") @db.Decimal(15, 4)
  amount       Decimal   @default(0) @db.Decimal(15, 4)
  currencyCode String?   @map("currency_code")
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")
  agreement    Agreement @relation(fields: [agreementId], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, agreementId])
  @@index([agreementId])
}

model AgreementApproval {
  id          String              @id @default(uuid())
  tenantId    String              @map("tenant_id")
  agreementId String              @map("agreement_id")
  approverId  String              @map("approver_id")
