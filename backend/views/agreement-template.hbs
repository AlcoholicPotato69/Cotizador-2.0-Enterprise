<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Convenio</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; }
    h1 { text-align: center; }
    .content { margin-top: 20px; line-height: 1.6; }
    .footer { margin-top: 50px; text-align: center; font-size: 12px; }
  </style>
</head>
<body>
  <h1>CONVENIO MODIFICATORIO</h1>
  <div class="content">
    <p>Fecha de emisión: <strong>{{fecha}}</strong></p>
    <p>Partes involucradas:</p>
    <ul>
      <li><strong>{{parteA}}</strong></li>
      <li><strong>{{parteB}}</strong></li>
    </ul>
    <p>Detalles del convenio:</p>
    <p>{{detalles}}</p>
  </div>
  <div class="footer">
    <p>Generado automáticamente - ID de Convenio: {{convenioId}}</p>
  </div>
</body>
</html>
