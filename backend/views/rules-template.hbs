<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Reglamento</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; }
    h1 { text-align: center; }
    .content { margin-top: 20px; line-height: 1.6; }
    .footer { margin-top: 50px; text-align: center; font-size: 12px; }
  </style>
</head>
<body>
  <h1>REGLAMENTO INTERNO</h1>
  <div class="content">
    <p>Fecha de emisión: <strong>{{fecha}}</strong></p>
    <p>Inmueble / Condominio: <strong>{{nombre_condominio}}</strong></p>
    <p>Las siguientes reglas aplican para todos los arrendatarios:</p>
    <ul>
      {{#each reglas}}
        <li>{{this}}</li>
      {{/each}}
    </ul>
  </div>
  <div class="footer">
    <p>Generado automáticamente - Reglamento ID: {{reglamentoId}}</p>
  </div>
</body>
</html>
