# ==============================================================================
# Cotizador 2.0 Enterprise - Environment Variables (Example)
# ==============================================================================
# Do not place real secrets in this file. Use it as a template for your local .env

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://your_db_user_here:your_db_password_here@localhost:5432/your_db_name_here?schema=public"

# Variables for local DB setup/docker
POSTGRES_USER=your_db_user_here
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=your_db_name_here

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET="your_jwt_secret_here"
REFRESH_SECRET="your_refresh_secret_here"
DOCUMENT_SIGNING_SECRET="your_document_signing_secret_here"

# Default admin credentials for seeding
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your_admin_password_here"

# ------------------------------------------------------------------------------
# Email (SMTP) Configuration
# ------------------------------------------------------------------------------
SMTP_HOST="your_smtp_host_here"
SMTP_PORT=587
SMTP_USER="your_smtp_user_here"
SMTP_PASSWORD="your_smtp_password_here"
SMTP_FROM_EMAIL="noreply@example.com"
SMTP_FROM_NAME="Cotizador System"

# ------------------------------------------------------------------------------
# Storage Configuration (AWS S3, MinIO, or Local)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="local" # Options: local, s3
STORAGE_ACCESS_KEY="your_storage_access_key_here"
STORAGE_SECRET_KEY="your_storage_secret_key_here"
STORAGE_REGION="your_storage_region_here"
STORAGE_BUCKET="your_storage_bucket_here"
STORAGE_ENDPOINT="your_storage_endpoint_here" # Required if using MinIO

# ------------------------------------------------------------------------------
# Third-Party Integrations: DocuSign
# ------------------------------------------------------------------------------
DOCUSIGN_CLIENT_ID="your_docusign_client_id_here"
DOCUSIGN_USER_ID="your_docusign_user_id_here"
DOCUSIGN_ACCOUNT_ID="your_docusign_account_id_here"
DOCUSIGN_PRIVATE_KEY="your_docusign_private_key_here"
DOCUSIGN_BASE_PATH="https://demo.docusign.net/restapi"
DOCUSIGN_AUTH_SERVER="account-d.docusign.com"

# ------------------------------------------------------------------------------
# ERP Integration: Intelisis
# ------------------------------------------------------------------------------
INTELISIS_API_URL="your_intelisis_api_url_here"
INTELISIS_API_USER="your_intelisis_user_here"
INTELISIS_API_PASSWORD="your_intelisis_password_here"
INTELISIS_COMPANY_ID="your_intelisis_company_id_here"
INTELISIS_BRANCH_ID="your_intelisis_branch_id_here"
