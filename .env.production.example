# ==============================================================================
# Cotizador 2.0 Enterprise - Environment Variables (Production Example)
# ==============================================================================
# Do not place real secrets in this file. Use it as a template for production

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
PORT=8080
NODE_ENV=production

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# IMPORTANT: Use a secure, managed database for production
DATABASE_URL="postgresql://prod_db_user_here:prod_db_password_here@prod_db_host:5432/prod_db_name_here?schema=public"

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# IMPORTANT: Generate strong, random secrets for production
JWT_SECRET="your_production_jwt_secret_here"
REFRESH_SECRET="your_production_refresh_secret_here"
DOCUMENT_SIGNING_SECRET="your_production_document_signing_secret_here"

# ------------------------------------------------------------------------------
# Email (SMTP) Configuration
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.production.provider.here"
SMTP_PORT=465
SMTP_USER="prod_smtp_user_here"
SMTP_PASSWORD="prod_smtp_password_here"
SMTP_FROM_EMAIL="cotizaciones@yourcompany.com"
SMTP_FROM_NAME="Cotizador Enterprise"

# ------------------------------------------------------------------------------
# Storage Configuration (AWS S3)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="s3" 
STORAGE_ACCESS_KEY="prod_aws_access_key_here"
STORAGE_SECRET_KEY="prod_aws_secret_key_here"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="prod_cotizador_bucket_here"
STORAGE_ENDPOINT="" # Leave blank for AWS S3, set for custom S3 compatible storage

# ------------------------------------------------------------------------------
# Third-Party Integrations: DocuSign
# ------------------------------------------------------------------------------
DOCUSIGN_CLIENT_ID="prod_docusign_client_id_here"
DOCUSIGN_USER_ID="prod_docusign_user_id_here"
DOCUSIGN_ACCOUNT_ID="prod_docusign_account_id_here"
DOCUSIGN_PRIVATE_KEY="prod_docusign_private_key_here"
DOCUSIGN_BASE_PATH="https://www.docusign.net/restapi"
DOCUSIGN_AUTH_SERVER="account.docusign.com"

# ------------------------------------------------------------------------------
# ERP Integration: Intelisis
# ------------------------------------------------------------------------------
INTELISIS_API_URL="https://prod-intelisis-api.yourcompany.com"
INTELISIS_API_USER="prod_intelisis_user_here"
INTELISIS_API_PASSWORD="prod_intelisis_password_here"
INTELISIS_COMPANY_ID="prod_company_id_here"
INTELISIS_BRANCH_ID="prod_branch_id_here"
